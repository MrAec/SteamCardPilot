<Window x:Class="SteamCardPilot.ParentalPinWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Family View PIN" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#EAF2FA" FontFamily="Segoe UI">
 <StackPanel Margin="28">
  <TextBlock Text="Family View PIN" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock x:Name="AccountLabel" Foreground="#469AFF" Margin="0,10,0,18"/>
  <TextBlock Text="Enter your existing four-digit Steam PIN. This does not change your Steam PIN." Foreground="{StaticResource Muted}"/>
  <PasswordBox x:Name="PinValue" MaxLength="4" FontSize="22" Margin="0,16,0,12" KeyDown="PinValue_KeyDown"/>
  <TextBlock Text="The PIN is stored in this computer's account configuration. Other settings are preserved." Foreground="{StaticResource Muted}" FontSize="12"/>
  <TextBlock x:Name="ErrorText" Foreground="#FFB0A7" Margin="0,12,0,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Save PIN" Click="Save_Click" Background="#1D6BD5" Foreground="White" Margin="0"/></StackPanel>
 </StackPanel>
</Window>

